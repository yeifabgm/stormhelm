#!/usr/bin/env bash
# Mock `gh` for the Ralph loop test (scripts/__tests__/ralph-loop.test.mjs).
# Deterministic; env-driven. Covers only the subcommands ralph-local.sh uses.
#   MOCK_LABELS  newline-separated labels for `issue view --json labels` (default: a valid contract)
#   MOCK_TITLE   title for `issue view --json title`
#   MOCK_READY   newline-separated issue numbers for `issue list` (queue mode)
sub="$1 $2"
# FOLLOW-UP 136: real gh checks --json field names on the client, and a field
# newer than the installed gh aborts the whole call. Accept only the fields
# gh 2.46.0 knows: distros still package it, and `baseRefOid`, for one, only
# exists from 2.63.0. A shipped call that needs a newer gh then fails here,
# not on an adopter's machine.
GH_246_PR_FIELDS="additions assignees author autoMergeRequest baseRefName body changedFiles closed closedAt comments commits createdAt deletions files headRefName headRefOid headRepository headRepositoryOwner id isCrossRepository isDraft labels latestReviews maintainerCanModify mergeCommit mergeStateStatus mergeable mergedAt mergedBy milestone number potentialMergeCommit projectCards projectItems reactionGroups reviewDecision reviewRequests reviews state statusCheckRollup title updatedAt url"
GH_246_ISSUE_FIELDS="assignees author body closed closedAt comments createdAt id labels milestone number projectCards projectItems reactionGroups state title updatedAt url"
case "$sub" in
  "pr view"|"pr list"|"issue view"|"issue list")
    known="$GH_246_PR_FIELDS"
    [ "$1" = issue ] && known="$GH_246_ISSUE_FIELDS"
    prev=""
    for a in "$@"; do
      if [ "$prev" = "--json" ]; then
        for f in $(printf '%s' "$a" | tr ',' ' '); do
          case " $known " in
            *" $f "*) ;;
            *) printf 'Unknown JSON field: "%s"\nAvailable fields:\n' "$f" >&2; exit 1 ;;
          esac
        done
      fi
      prev="$a"
    done ;;
esac
case "$sub" in
  "issue view")
    labels="${MOCK_LABELS-ralph-ready
scenarios:scn-001
budget:50k}"
    if printf '%s\n' "$@" | grep -q "labels,title"; then
      # Combined fetch (FOLLOW-UP 36, +body since FOLLOW-UP 49): real JSON.
      jq -n --arg l "$labels" --arg t "${MOCK_TITLE:-Feature X}" --arg b "${MOCK_BODY:-}" \
        '{labels: ($l | split("\n") | map(select(length > 0) | {name: .})), title: $t, body: $b}'
    elif printf '%s\n' "$@" | grep -q labels; then
      printf '%s\n' "$labels"
    elif printf '%s\n' "$@" | grep -q title; then
      printf '%s\n' "${MOCK_TITLE:-Feature X}"
    elif printf '%s\n' "$@" | grep -q body; then
      # FOLLOW-UP 64: dep-of-dep lookups — per-issue body via MOCK_BODY_<n>,
      # falling back to the global MOCK_BODY.
      if eval "[ -n \"\${MOCK_BODY_${3}:-}\" ]"; then
        eval "printf '%s\n' \"\$MOCK_BODY_${3}\""
      else
        printf '%s\n' "${MOCK_BODY:-}"
      fi
    fi ;;
  "issue list")
    # FOLLOW-UP 43 (dependency-aware queue): two JSON variants —
    #   --json number,body          → MOCK_QUEUE_JSON (candidates with Depends-on
    #                                 bodies; default: MOCK_READY numbers, empty bodies)
    #   --json number,state,labels  → MOCK_ALL_JSON (satisfaction snapshot; default [])
    # Legacy plain form keeps emitting MOCK_READY lines.
    if printf '%s\n' "$@" | grep -q "number,body"; then
      if [ -n "${MOCK_QUEUE_JSON:-}" ]; then printf '%s\n' "$MOCK_QUEUE_JSON"
      else jq -n --arg r "${MOCK_READY:-1}" '[ $r | split("\n")[] | select(length > 0) | {number: (. | tonumber), body: ""} ]'; fi
    elif printf '%s\n' "$@" | grep -q "number,state,labels"; then
      printf '%s\n' "${MOCK_ALL_JSON:-[]}"
    else
      printf '%s\n' "${MOCK_READY:-1}"
    fi ;;
  "pr list")
    # FOLLOW-UP 102: --head queries (the duplicate-PR guard) answer with the
    # existing-PR number (or empty). Checked BEFORE --base since the guard call
    # carries both. The script uses `--jq '.[0].number // empty'`, so emit the
    # already-filtered value the way gh's --jq would.
    if printf '%s\n' "$@" | grep -q -- "--head"; then
      printf '%s\n' "${MOCK_EXISTING_PR:-}"
      exit 0
    fi
    # FOLLOW-UP 60: --base queries answer the dependents JSON.
    if printf '%s\n' "$@" | grep -q -- "--base"; then
      printf '%s\n' "${MOCK_PR_DEPENDENTS_JSON:-[]}"
      exit 0
    fi
    # FOLLOW-UP 100: --label merge-unit:* queries answer the unit-siblings JSON
    # (train-merge's order guard lists the unit's open members).
    if printf '%s\n' "$@" | grep -q -- "--label"; then
      printf '%s\n' "${MOCK_UNIT_SIBLINGS_JSON:-[]}"
      exit 0
    fi
    # Pre-formatted rows (the real call uses --jq); empty by default so the
    # watcher's empty-list path (FOLLOW-UP 32 lesson 3) is exercised.
    # FOLLOW-UP 48: per-dep branch discovery — when the --jq carries a
    # "Closes #N" filter and MOCK_PR_BRANCH_<N> is set, answer per dep
    # (a multi-dep chain needs DIFFERENT branches per dependency).
    dep=$(printf '%s\n' "$@" | grep -oE 'Closes #[0-9]+' | grep -oE '[0-9]+' | head -1)
    if [ -n "$dep" ] && eval "[ -n \"\${MOCK_PR_BRANCH_${dep}:-}\" ]"; then
      eval "printf '%s\n' \"\$MOCK_PR_BRANCH_${dep}\""
    elif [ -n "${MOCK_PR_LIST:-}" ]; then printf '%s\n' "$MOCK_PR_LIST"; fi ;;
  "pr view")
    # FOLLOW-UP 136: a `gh pr view` that fails (auth, network, a missing PR).
    if [ -n "${MOCK_PR_VIEW_FAIL:-}" ]; then
      printf '%s\n' "$MOCK_PR_VIEW_FAIL" >&2
      exit 1
    fi
    # FOLLOW-UP 60 (train-merge): JSON views keyed by requested fields.
    # NOTE: no inline JSON defaults — a literal '}' inside ${VAR:-...}
    # terminates the expansion early and emits garbage.
    if printf '%s\n' "$@" | grep -q "statusCheckRollup"; then
      # FOLLOW-UP 91: the expected-checks gate reads the rollup separately.
      # Default `null` (not inline JSON — a literal '}' breaks ${VAR:-…}); the
      # script treats null as "no checks reported".
      printf '%s\n' "${MOCK_ROLLUP_JSON:-null}"
    elif printf '%s\n' "$@" | grep -q "mergeCommit"; then
      printf '%s\n' "${MOCK_TRAIN_POST_JSON:-null}"
    elif printf '%s\n' "$@" | grep -q "mergeable"; then
      printf '%s\n' "${MOCK_TRAIN_PRE_JSON:-null}"
    elif printf '%s\n' "$@" | grep -q "headRefName"; then
      printf '%s\n' "${MOCK_TRAIN_VIEW_JSON:-null}"
    else
      # FOLLOW-UP 56: exists only when listed in MOCK_PR_EXISTS (space-sep).
      case " ${MOCK_PR_EXISTS:-} " in
        *" $3 "*) echo "pr #$3" ;;
        *) echo "no pull requests found" >&2; exit 1 ;;
      esac
    fi ;;
  "api graphql")
    # FOLLOW-UP 136: check-merge-safety reads the PR's base oid through
    # GraphQL. Answer only the call real gh would answer: the number sent
    # typed (`-F`, GraphQL wants an Int!), the baseRefOid query and its --jq
    # path. Print it already --jq-filtered, as gh does. MOCK_BASE_OID unset →
    # the call fails, the way an unreachable API does.
    typed_number=""
    prev=""
    for a in "$@"; do
      if [ "$prev" = "-F" ]; then
        case "$a" in number=[0-9]*) typed_number=1 ;; esac
      fi
      prev="$a"
    done
    if [ -z "$typed_number" ] \
      || ! printf '%s\n' "$@" | grep -qF 'pullRequest(number: $number) { baseRefOid }' \
      || ! printf '%s\n' "$@" | grep -qxF '.data.repository.pullRequest.baseRefOid'; then
      printf '%s\n' 'gh: Variable $number of type Int! was provided invalid value' >&2
      exit 1
    fi
    if [ -n "${MOCK_BASE_OID:-}" ]; then
      printf '%s\n' "$MOCK_BASE_OID"
    else
      printf '%s\n' 'error connecting to api.github.com' >&2
      exit 1
    fi ;;
  "pr edit")
    # FOLLOW-UP 60: ordering log — retarget must precede merge.
    printf 'EDIT %s\n' "$*" >> .mock-gh-trainlog ;;
  "pr merge")
    printf 'MERGE %s\n' "$*" >> .mock-gh-trainlog ;;
  "pr create")
    # Real gh contract (FOLLOW-UP 29): creating a PR for a branch that was
    # never pushed aborts. The sentinel is written by the mock git's `push`.
    if [ -f .mock-pushed ]; then
      # Record full args (title/body) for FU-33/FU-36 assertions.
      printf '%s\n―――\n' "$*" >> .mock-gh-prcreate
      echo "https://github.com/acme/app/pull/9"
    else
      echo "aborted: you must first push the current branch to a remote, or use the --head flag" >&2
      exit 1
    fi ;;
  "issue comment")
    # Record posted comments so tests can assert on them (FOLLOW-UP 26).
    printf '%s\n―――\n' "$*" >> .mock-gh-comments ;;
  "label create")
    # Record label provisioning so tests can assert on it (FOLLOW-UP 30a).
    printf '%s\n' "$*" >> .mock-gh-labels ;;
  "issue edit")
    # FOLLOW-UP 41: real gh REFUSES --add-label for a label that doesn't
    # exist in the repo (and the engine used to swallow that failure
    # silently). Enforce here: every added label must have been
    # `label create`d first — pins the live failure mode so the JIT
    # provisioning can't regress silently.
    prev=""
    for a in "$@"; do
      if [ "$prev" = "--add-label" ]; then
        for lbl in $(printf '%s' "$a" | tr ',' ' '); do
          if ! grep -q -- "$lbl" .mock-gh-labels 2>/dev/null; then
            echo "failed to update: '$lbl' not found" >&2
            exit 1
          fi
        done
      fi
      prev="$a"
    done ;;
  *) : ;;
esac
exit 0
